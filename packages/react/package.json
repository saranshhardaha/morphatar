{
  "name": "@morphatar/react",
  "version": "0.1.1",
  "description": "React wrapper for Morphatar — deterministic algorithmic avatars.",
  "license": "MIT",
  "author": "Saransh Hardaha",
  "homepage": "https://morphatar.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranshhardaha/morphatar.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/saranshhardaha/morphatar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "avatar",
    "avatar-generator",
    "avatars",
    "identicon",
    "react",
    "react-component",
    "svg",
    "deterministic",
    "generative-art",
    "profile-picture",
    "zero-dependencies",
    "boring-avatars"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm --filter @morphatar/core build && pnpm build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "dependencies": {
    "@morphatar/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1"
  }
}
